# Copy this file to .env.local and fill in the values.

# Supabase (Project Settings → API). Both are safe to expose to browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The public address of the site, no trailing slash. Used in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Confirmation emails, sent through a Gmail account.
# Create an app password at https://myaccount.google.com/apppasswords
# (the account needs 2-step verification turned on). Leave blank to skip emails.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where "new booking" notices go. Defaults to GMAIL_USER.
NOTIFY_EMAIL=
